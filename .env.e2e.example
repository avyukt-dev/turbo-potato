# Source .env.test.local first for the disposable PostgreSQL/Redis URLs, then this file.
# Copy this file to .env.e2e.local and fill the secret values locally. Never commit that file.

export NEWS_AI_ENVIRONMENT=production
export NEWS_AI_E2E_CONFIRM_LIVE=LIVE_INSTAGRAM_E2E

# Local API process used for real human review and publication HTTP boundaries.
export NEWS_AI_E2E_API_BASE_URL=http://127.0.0.1:8000
export NEWS_AI_REVIEW_API_TOKEN=
export NEWS_AI_REVIEWER_ID=
export NEWS_AI_REVIEW_CAPABILITIES=view,review,approve,publish

# Real Groq.
export GROQ_API_KEY=

# Real Instagram test destination.
export NEWS_AI_SOCIAL_MODE=LIVE
export NEWS_AI_PUBLISHING_ENABLED=true
export NEWS_AI_PUBLISHING_PAUSED=false
export NEWS_AI_INSTAGRAM_ACCOUNT_ID=
export NEWS_AI_INSTAGRAM_ACCESS_TOKEN=

# Real external inputs. Comma-separate multiple URLs.
export NEWS_AI_E2E_FEED_URLS=
export NEWS_AI_E2E_MEDIA_URLS=

# Optional safety/bounding controls.
export NEWS_AI_E2E_MAX_ARTICLES_TOTAL=3
export NEWS_AI_E2E_TIMEOUT_SECONDS=900
export NEWS_AI_E2E_POLL_INTERVAL_SECONDS=0.5
export NEWS_AI_E2E_MEDIA_MAX_BYTES=10000000
# export NEWS_AI_E2E_ARTICLE_TITLE_CONTAINS=
# export NEWS_AI_E2E_ACCOUNT_NAME=live-e2e-test-account
