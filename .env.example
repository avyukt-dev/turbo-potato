NEWS_AI_ENVIRONMENT=development
NEWS_AI_CONFIG_DIR=config
NEWS_AI_LOG_LEVEL=INFO
NEWS_AI_DATABASE_URL=postgresql+psycopg://news_ai:change-me@127.0.0.1:5432/news_ai
NEWS_AI_REDIS_URL=redis://127.0.0.1:6379/0
NEWS_AI_READINESS_TIMEOUT_SECONDS=2
# AI credentials are supplied outside version control. Each numbered slot has
# independent operational health/cooldown state; more slots do not imply more quota.
# Numbered AI credential pools support gaps. The unsuffixed legacy name may be
# used as slot 1 temporarily, but must not be combined with the corresponding _1.
# GROQ_API_KEY_1=
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=
# Social publication is inert by default. LIVE additionally requires environment=production,
# platform enablement, an account ID, and a secret token supplied outside version control.
NEWS_AI_SOCIAL_MODE=MOCK
NEWS_AI_PUBLISHING_ENABLED=false
# Stage-25 due-work dispatch is separately paused by default; no adapter is invoked.
NEWS_AI_PUBLISHING_PAUSED=true
# NEWS_AI_INSTAGRAM_ACCOUNT_ID=
# NEWS_AI_INSTAGRAM_ACCESS_TOKEN=
# Human review channels. Keep every credential outside version control.
# NEWS_AI_REVIEW_API_TOKEN=
# NEWS_AI_REVIEWER_ID=
# NEWS_AI_REVIEW_CAPABILITIES=view,review,approve
NEWS_AI_TELEGRAM_REVIEW_ENABLED=false
# NEWS_AI_TELEGRAM_BOT_TOKEN=
# NEWS_AI_TELEGRAM_WEBHOOK_SECRET=
# NEWS_AI_TELEGRAM_REVIEW_CHAT_ID=
# NEWS_AI_TELEGRAM_REVIEWER_USER_ID=
# AI-generated, watermarked media. The public base must expose the generated
# directory over HTTPS so Telegram and Instagram can retrieve exact bytes.
NEWS_AI_MEDIA_GENERATION_ENABLED=false
NEWS_AI_GENERATED_MEDIA_STORAGE_BACKEND=local
NEWS_AI_GENERATED_MEDIA_DIRECTORY=var/generated-media
NEWS_AI_GENERATED_MEDIA_KEY_PREFIX=
# NEWS_AI_GENERATED_MEDIA_PUBLIC_BASE_URL=https://media.example.com/generated
# S3-compatible storage. AWS uses its normal SDK credential chain when explicit
# credentials are omitted. Cloudflare R2 requires provider=cloudflare-r2,
# region=auto, its account endpoint, and explicit bucket-scoped credentials.
# NEWS_AI_GENERATED_MEDIA_S3_PROVIDER=aws
# NEWS_AI_GENERATED_MEDIA_S3_BUCKET=news-ai-media
# NEWS_AI_GENERATED_MEDIA_S3_REGION=ap-south-1
# NEWS_AI_GENERATED_MEDIA_S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
# NEWS_AI_GENERATED_MEDIA_S3_ACCESS_KEY_ID=
# NEWS_AI_GENERATED_MEDIA_S3_SECRET_ACCESS_KEY=
# NEWS_AI_GENERATED_MEDIA_S3_SESSION_TOKEN=
# OPENAI_API_KEY_1=
# OPENAI_API_KEY_2=
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# Optional explicit override. Leave unset for capability detection.
# NEWS_AI_SERVICE_MANAGER=openrc
